# Agent HQ untuk Hermes Agent. Dibaca hq_hook.py dan hq_mcp.py dari folder yang sama.
# Env var dengan nama yang sama selalu menang atas file ini.

# Alamat Agent HQ (tanpa /api). Agent HQ di VPS ini, atau di laptop lewat tunnel `ssh -R`:
# keduanya tetap 127.0.0.1. Lihat docs/hermes.md bagian 1.
HQ_URL=http://127.0.0.1:8787

# Isi kalau Agent HQ dijalankan dengan HQ_TOKEN.
#HQ_TOKEN=

# Nama, peran, dan tim default untuk semua sesi Hermes. Tim: red, report, blue, atau kosong.
# Gateway (service) dan server MCP hanya membaca file ini. Sesi CLI juga bisa lewat env:
# HQ_NAME=Rexx HQ_TEAM=red hermes
#HQ_NAME=
#HQ_ROLE=
#HQ_TEAM=

# Batas tunggu kirim ke Agent HQ, dalam detik.
#HQ_TIMEOUT=1.5

# Hanya untuk MCP tanpa hook: munculkan karakter begitu Hermes menyala.
#HQ_ANNOUNCE=1

# Matikan sementara tanpa mengubah config.yaml Hermes.
#HQ_DISABLE=1
