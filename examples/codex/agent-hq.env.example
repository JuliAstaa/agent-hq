# Agent HQ untuk Codex. Dibaca hq_codex.mjs dari folder yang sama (~/.codex/agent-hq/).
# Env var dengan nama yang sama selalu menang atas file ini.

# Alamat Agent HQ (tanpa /api).
HQ_URL=http://127.0.0.1:8787

# Isi kalau Agent HQ dijalankan dengan HQ_TOKEN.
#HQ_TOKEN=

# Nama, peran, dan tim default untuk semua sesi Codex, termasuk ekstensi VS Code yang tidak membawa env
# dari terminal. Tim: red, report, blue, atau kosong. Per sesi lewat env: HQ_NAME=Rexx HQ_TEAM=red codex
#HQ_NAME=
#HQ_ROLE=
#HQ_TEAM=
# Grup kerja: sesi dengan grup yang sama rapat bersama di ruang Meeting (subagen ikut otomatis).
#HQ_GROUP=

# Batas tunggu kirim ke Agent HQ, dalam detik.
#HQ_TIMEOUT=1.5

# Matikan sementara tanpa mengubah hooks.json.
#HQ_DISABLE=1
